NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publicavel
OPENAI_API_KEY=sua-chave-secreta-openai
OPENAI_MODEL=gpt-5.6-luna
PERPLEXITY_API_KEY=sua-chave-secreta-perplexity
PERPLEXITY_MODEL=sonar

# Somente para testes E2E locais/CI. Nunca use uma conta administrativa.
E2E_BASE_URL=
E2E_EMAIL=candidato-de-teste@exemplo.com
E2E_PASSWORD=senha-exclusiva-de-teste

# Asaas: segredos exclusivamente no servidor. Começar pelo sandbox.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_SITE_ORIGIN=https://www.notaalvo.com.br
ASAAS_CHECKOUT_ENABLED=false
SUPABASE_SERVICE_ROLE_KEY=

# Segredo server-side para o agendamento semanal do Radar de Redação.
CRON_SECRET=gere-um-segredo-aleatorio-longo
